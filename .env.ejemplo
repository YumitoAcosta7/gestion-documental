# Copiar a .env en /opt/gestion-documental (infra/rocky/desplegar.sh lo hace la primera vez).
# .env está excluido de git. No contiene contraseñas: esas van en CARPETA_SECRETOS.
# Dejar activo solo el bloque del ambiente de este servidor.

# ---- Producción (caliope)
IMAGEN_APP=gestion-documental:COMPLETAR_CON_LA_ETIQUETA_PROBADA_EN_DESARROLLO
DB_HOST=atenea.asuncion.gov.py
BASE=gestion_documental
ROL_APLICACION=gestion_documental
AMBIENTE_VISIBLE=
MEMORIA_APP=1536m

# ---- Desarrollo (caliopedev)
#IMAGEN_APP=gestion-documental:dev
#DB_HOST=ateneadev.asuncion.gov.py
#BASE=gestion_documental_pruebas
#ROL_APLICACION=gestion_documental_pruebas
#AMBIENTE_VISIBLE=DESARROLLO
#MEMORIA_APP=1024m

# ---- Comunes
DB_PUERTO=5432
CARPETA_DATOS=/var/lib/gestion-documental
CARPETA_SECRETOS=/etc/gestion-documental/secretos
UID_APP=10001
