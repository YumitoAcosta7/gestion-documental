# Copiar a .env en /opt/gestion-documental (infra/rocky/desplegar.sh lo hace la primera vez).
# .env está excluido de git. No contiene contraseñas: esas van en CARPETA_SECRETOS.

# Imagen de la aplicación. En producción, la etiqueta exacta que se probó en desarrollo
IMAGEN_APP=gestion-documental:dev
# Fijar la versión menor: la misma que la base de origen al restaurar (hoy, 17.10)
IMAGEN_POSTGRES=postgres:17-bookworm

BASE=gestion_documental
ROL_APLICACION=gestion_documental

CARPETA_DATOS=/var/lib/gestion-documental
CARPETA_SECRETOS=/etc/gestion-documental/secretos

MEMORIA_APP=1536m
UID_APP=10001
