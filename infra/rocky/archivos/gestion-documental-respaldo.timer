[Unit]
Description=Respaldo diario de Gestión Documental

[Timer]
# El servidor está en UTC: la hora se fija en la de Asunción, fuera del horario de uso
OnCalendar=*-*-* 22:00:00 America/Asuncion
# Si el servidor estaba apagado a esa hora, lo hace al encender
Persistent=true

[Install]
WantedBy=timers.target
