[Unit]
Description=Respaldo de Gestión Documental (base por la red y PDF)
# La base está en el servidor PostgreSQL del ambiente: hace falta la red
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/env bash /opt/gestion-documental/despliegue/respaldar.sh
